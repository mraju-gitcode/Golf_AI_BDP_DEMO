# Copy to .env and fill in. Without a key the demo runs in offline (rules) mode.
OPENAI_API_KEY=
# offline | llm  (llm is used automatically when a key is present, unless forced offline)
GOLFPM_MODE=
GOLFPM_TRIAGE_MODEL=gpt-5-mini
GOLFPM_REPLY_MODEL=gpt-5-mini
GOLFPM_REASONING_EFFORT=low

# Live mailbox (optional). The address is the GolfPM shared mailbox; the password is a
# Google App Password (myaccount.google.com/apppasswords), never the normal password.
GOLFPM_MAILBOX_ADDRESS=
GOLFPM_MAILBOX_PASSWORD=
GOLFPM_POLL_SECONDS=10
